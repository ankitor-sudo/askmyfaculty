rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.email in ['ankitornkit@gmail.com', 'admin@askmyfaculty.edu', 'admin@askmyfaculty.com']
      );
    }
    
    function isApprovedFaculty() {
      return isAuthenticated() && 
        getUserData().role == 'faculty' && 
        getUserData().approvalStatus == 'approved';
    }

    // ── USERS COLLECTION ──
    match /users/{userId} {
      // Anyone logged in can read user profiles (needed for student questions, faculty directory, admin)
      allow read: if isAuthenticated();
      
      // Users can create their own profile during registration
      // But they cannot make themselves 'admin' or immediately 'approved' unless admin
      allow create: if isUser(userId) && (
        request.resource.data.role != 'admin' || isAdmin()
      );
      
      // Users can update non-privileged fields of their own profile (name, section, etc.)
      // Only admins can change 'role' or 'approvalStatus'
      allow update: if isAdmin() || (
        isUser(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approvalStatus'])
      );
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // ── QUERIES COLLECTION ──
    match /queries/{queryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentId == request.auth.uid ||
        isApprovedFaculty()
      );
      allow delete: if isAuthenticated() && (
        isAdmin() || resource.data.studentId == request.auth.uid
      );
    }
    
    // ── ANNOUNCEMENTS COLLECTION ──
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isApprovedFaculty();
    }
  }
}
